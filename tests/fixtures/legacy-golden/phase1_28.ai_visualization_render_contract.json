      "expectedRender": {"visible": true}
    },
    {
      "id": "mermaid-hostile-blocked",
      "coverage": ["blocked-active-content", "escaped-fallback"],
      "dto": {
        "kind": "mermaid", "diagram": "flowchart LR\n  A[\"<img src='x' onerror='alert(1)'>\"] --> B[Saída]",
        "title": "Diagrama inválido", "caption": "Conteúdo não confiável"
      },
      "expectedRender": {"visible": false}
    }
