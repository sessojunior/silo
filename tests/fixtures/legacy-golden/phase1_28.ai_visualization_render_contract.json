{
  "visualizations": [
    {
      "id": "chart-bar-hostile-negative",
      "coverage": ["bar", "negative-values", "escaped-labels"],
      "dto": {
        "kind": "chart", "chartType": "bar",
        "title": "Incidentes <script>alert(1)</script>",
        "subtitle": "Variação por produto",
        "categories": ["<img src='x' onerror='alert(1)'>", "BAM"],
        "series": [{"name": "Variação", "values": [-3, 5], "color": "#3b82f6"}]
      },
      "expectedRender": {"echartsSeriesType": "bar"}
    },
    {
      "id": "chart-line-truncated",
