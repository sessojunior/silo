# Arquivos desnecessários para o Docker
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Arquivos de ambiente (usar .env no host)
.env
**/.env
.env.*
**/.env.*
!.env.example
!**/.env.example

# Arquivos de build e cache
.next/
**/.next/
out/
**/out/
dist/
build/

# Python gerado localmente
apps/backend/.venv/
apps/backend/.mypy_cache/
apps/backend/.pytest_cache/
apps/backend/.ruff_cache/
apps/backend/.coverage
apps/backend/htmlcov/
apps/backend/**/__pycache__/
apps/backend/**/*.py[cod]
apps/backend/.hypothesis/
.uv-cache/

# Arquivos de upload (serão montados como volume)
uploads/

# Logs e temporários
*.log
temp/
logs/

# Arquivos de teste
test-results/
playwright-report/
coverage/

# Arquivos do sistema
.DS_Store
Thumbs.db

# Arquivos de IDE
.vscode/
.idea/
*.swp
*.swo

# Arquivos Git
.git/
.gitignore
