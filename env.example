# Ambiente de desenvolvimento ou produção
# SILO_ENV controla o modo do backend (development/test/production).
# NODE_ENV controla o runtime do frontend (next start exige production).
NODE_ENV=production
SILO_ENV=development
LOG_LEVEL=INFO

# Web e API
# API_URL: origem interna do backend usada pelo proxy/instrumentation do web.
# Em Docker, o compose injeta http://api:4000 automaticamente.
API_URL=http://localhost:4000
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_BASE_PATH=/silo
# Somente fora do Docker: o build da imagem nao injeta esta variavel.
NEXT_PUBLIC_SMOKE_MODE=false
# APP_URL_DEV/APP_URL_PROD: origem da aplicacao SEM o basePath.
# No Docker local, use http://localhost (web exposto na porta SILO_HOST_PORT).
# Fora do Docker (npm run dev), use http://localhost:3000.
APP_URL_DEV=http://localhost
# APP_URL_DEV=http://localhost:3000
# Em producao, aponte para o dominio real da aplicacao.
APP_URL_PROD=http://localhost
# APP_URL_PROD=https://fortuna.cptec.inpe.br
# Origens liberadas para CORS (backend). Inclui http://localhost para o Docker (porta 80).
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000

# Portas expostas no host
SILO_HOST_PORT=80
API_PORT=4000

# Banco de dados
# Em containers (docker compose), o host e o servico `db`. Fora do Docker, use localhost.
DATABASE_URL=postgresql://silo:silo@db:5432/silo
# DATABASE_URL=postgresql://silo:silo@localhost:5432/silo
POSTGRES_DB=silo
POSTGRES_USER=silo
POSTGRES_PASSWORD=silo
POSTGRES_PORT=5432
SILO_POSTGRES_IMAGE=pgvector/pgvector:pg17@sha256:f193b9c848deb27b0e892f85ed07b53fd83ccb1feb634ba415b1cdc44411bedc

# Autenticação
BETTER_AUTH_SECRET=your_secret_key_here
# Se vazio, o backend usa BETTER_AUTH_SECRET como fallback.
SESSION_SECRET=your_session_secret_here
ALLOWED_EMAIL_DOMAINS=
TRUSTED_PROXY_CIDRS=

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
# Se vazio, o backend deriva o remetente do SMTP_USERNAME.
SMTP_FROM=noreply@silo.local

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kafka REST Proxy
KAFKA_REST_PROXY_URL=http://localhost:8082
KAFKA_REST_PROXY_AUTH=
KAFKA_REST_PROXY_USE_MOCK_DATA=true
KAFKA_DATAFLOW_TOPIC_PREFIX=silo.dataflow.
KAFKA_GROUP_ID=silo-consumer-group
# O worker de producao precisa de pelo menos um topico. Use KAFKA_TOPIC para
# um unico topico ou KAFKA_TOPICS para varios topicos separados por virgula.
# Se ambos forem definidos, KAFKA_TOPIC tem precedencia.
KAFKA_TOPIC=
KAFKA_TOPICS=
KAFKA_DLQ_PREFIX=dlq.
KAFKA_PROCESS_RETRY_COUNT=3
KAFKA_RETRY_BACKOFF_MS=1000

# Embeddings do SILO — vLLM dedicado
# A geração de respostas fica no Compose compartilhado do Qwen.
SILO_VLLM_CPU_IMAGE=vllm/vllm-openai-cpu:v0.29.0-x86_64
# Porta da instancia vllm dedicada ao modelo de embedding (acesso via host).
VLLM_EMBED_PORT=8001
# Fora do Docker, o backend usa o endpoint publicado do Qwen compartilhado.
VLLM_URL=http://localhost:8000/v1
# Dentro do Docker o compose sempre injeta http://embeddings:8000/v1;
# use localhost:8001 somente ao rodar o backend diretamente no host.
VLLM_EMBEDDING_URL=http://localhost:8001/v1
VLLM_MODEL=qwen
# bge-base-en-v1.5 tem 768 dimensoes (o pgvector do SILO exige 768).
VLLM_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Timeout em ms para chamadas vllm (CPU e lento; use valores maiores).
VLLM_TIMEOUT_MS=180000
VLLM_MAX_CONCURRENT_REQUESTS=4
# Imagem GPU usada pelo serviço de embeddings no deploy.
SILO_VLLM_GPU_IMAGE=vllm/vllm-openai:v0.29.0
SILO_VLLM_EMBED_GPU_MEM_UTIL=0.20
# Com duas A2, o Qwen usa a GPU 0 e os embeddings usam a GPU 1.
SILO_VLLM_EMBED_GPU_ID=1

# Modelo compartilhado entre o SILO e outros projetos.
QWEN_IMAGE=vllm/vllm-openai:v0.29.0
QWEN_MODEL=Qwen/Qwen2.5-0.5B-Instruct
QWEN_SERVED_MODEL=qwen
QWEN_PORT=8000
QWEN_BIND_ADDRESS=127.0.0.1
QWEN_GPU_ID=0
QWEN_GPU_MEMORY_UTILIZATION=0.70
QWEN_MAX_MODEL_LEN=8192
HF_TOKEN=
AI_AGENT_MODE=hybrid
AI_AGENT_MAX_ROUNDS=2
AI_AGENT_MAX_TOOL_CALLS=4
AI_AGENT_TOOL_TIMEOUT_MS=60000
EMBEDDING_BACKFILL_INTERVAL_SECONDS=300
LANGSMITH_TRACING=false
LANGSMITH_TRACING_APPROVED=false

# Arquivos
# Em Docker, o compose usa /app/uploads. Fora do Docker, vazio usa uploads/
# no diretorio de execucao do backend.
UPLOADS_DIR=

# Integrações
# Chave para integracao de data-flow de produtos (opcional).
PRODUCT_FLOW_API_KEY=

# Deploy (docker-compose.deploy.yml)
SILO_IMAGE=silo-api:latest

# Timezone (informacional: os containers fixam TZ=America/Sao_Paulo no compose)
TZ=America/Sao_Paulo
