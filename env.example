# Ambiente de desenvolvimento ou produção
NODE_ENV=development
SILO_ENV=development
LOG_LEVEL=INFO

# Web e API
API_URL=http://localhost:4000
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_BASE_PATH=/silo
NEXT_PUBLIC_SMOKE_MODE=false
APP_URL_DEV=http://localhost:3000
APP_URL_PROD=https://fortuna.cptec.inpe.br
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Banco de dados
# Em containers (docker compose), o host e o servico `db`. Fora do Docker, use localhost.
DATABASE_URL=postgresql://silo:silo@db:5432/silo
# DATABASE_URL=postgresql://silo:silo@localhost:5432/silo
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
SILO_POSTGRES_IMAGE=pgvector/pgvector:pg17@sha256:f193b9c848deb27b0e892f85ed07b53fd83ccb1feb634ba415b1cdc44411bedc

# Autenticação
BETTER_AUTH_SECRET=your_secret_key_here
SESSION_SECRET=your_session_secret_here
ALLOWED_EMAIL_DOMAINS=
TRUSTED_PROXY_CIDRS=

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@silo.local

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kafka REST Proxy
KAFKA_REST_PROXY_URL=http://localhost:8082
KAFKA_REST_PROXY_AUTH=
KAFKA_REST_PROXY_USE_MOCK_DATA=true
KAFKA_DATAFLOW_TOPIC_PREFIX=silo.dataflow.
KAFKA_GROUP_ID=silo-consumer-group
KAFKA_TOPIC=
KAFKA_TOPICS=
KAFKA_DLQ_PREFIX=dlq.
KAFKA_PROCESS_RETRY_COUNT=3
KAFKA_RETRY_BACKOFF_MS=1000

# IA — vLLM (modelos locais)
# Imagem CPU oficial (roda sem GPU, mais lenta). Com GPU NVIDIA, use:
# SILO_VLLM_IMAGE=vllm/vllm-openai:v0.11.2
SILO_VLLM_IMAGE=vllm/vllm-openai-cpu:v0.27.1-x86_64
VLLM_PORT=8000
# Porta da instancia vllm dedicada ao modelo de embedding (acesso via host).
VLLM_EMBED_PORT=8001
# Dentro do Docker o backend usa http://vllm-embed:8000/v1 automaticamente;
# defina VLLM_EMBEDDING_URL apenas para rodar o backend FORA do Docker.
# VLLM_EMBEDDING_URL=http://localhost:8001/v1
VLLM_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# bge-base-en-v1.5 tem 768 dimensoes (o pgvector do SILO exige 768).
VLLM_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Timeout em ms para chamadas vllm (CPU e lento; use valores maiores).
VLLM_TIMEOUT_MS=180000
VLLM_MAX_CONCURRENT_REQUESTS=4
VLLM_MAX_MODEL_LEN=16384
VLLM_DTYPE=bfloat16
# Cache KV do vLLM em CPU (GB). Aumente se tiver RAM sobrando.
VLLM_CPU_KVCACHE_SPACE=1
HF_TOKEN=
AI_AGENT_MODE=deterministic
LANGSMITH_TRACING=false
LANGSMITH_TRACING_APPROVED=false

# Arquivos
UPLOADS_DIR=/app/uploads
