    },
    {
      "method": "POST",
      "apiPath": "/api/auth/sign-up/email/send-otp",
      "owner": "auth-custom",
      "source": ["apps/api/src/routes/auth-custom/sign-up-email.routes.ts", "apps/frontend/src/app/(auth)/login/page.tsx", "apps/frontend/src/app/(auth)/register/page.tsx", "phase1_6_validation"]
    },
    {
      "method": "POST",
      "apiPath": "/api/auth/sign-up/email/verify-otp",
      "owner": "auth-custom",
      "source": ["apps/api/src/routes/auth-custom/sign-up-email.routes.ts", "apps/frontend/src/app/(auth)/login/page.tsx", "apps/frontend/src/app/(auth)/register/page.tsx", "phase1_8"]
