    },
    {
      "method": "POST",
      "apiPath": "/api/auth/setup-password",
      "owner": "auth-custom",
      "source": ["apps/api/src/routes/auth-custom/login-password.routes.ts", "apps/frontend/src/app/(auth)/setup-password/page.tsx", "apps/frontend/src/app/(auth)/forget-password/page.tsx", "phase1_8"]
