    },
    {
      "method": "POST",
      "apiPath": "/api/auth/sign-in/email",
      "owner": "better-auth-passthrough",
      "source": ["apps/api/src/routes/auth.ts", "phase1_8", "phase1_9"]
    },
    {
      "method": "POST",
      "apiPath": "/api/auth/sign-out",
      "owner": "better-auth-passthrough",
      "source": ["apps/api/src/routes/auth.ts", "apps/frontend/src/context/logout-context.tsx", "phase1_8", "phase1_9"]
