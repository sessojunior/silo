    },
    {
      "method": "POST",
      "apiPath": "/api/auth/login-email/send-otp",
      "owner": "auth-custom",
      "source": ["apps/api/src/routes/auth-custom/login-email.routes.ts", "apps/frontend/src/app/(auth)/login-email/page.tsx", "phase1_8"]
    },
    {
      "method": "POST",
