{
  "$schema": "https://silo.local/schemas/migration-access-log-compensating-allowlist.v1.json",
  "version": "2026-07-21.phase-1.10",
  "status": "approved_compensating_control_no_access_logs_available",
  "decision": {
    "reason": "Staging/production access logs covering seven days are not available to the executor.",
    "authorizedBy": "user",
    "authorizedAt": "2026-07-21",
    "rule": "Only endpoints in this allowlist are treated as migration contract for Better Auth/external inbound discovery. Any newly discovered production/staging endpoint before cutover must stop the migration until characterized."
  },
