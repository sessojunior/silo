      "owner": "web-instrumentation-ai-warmup",
      "source": ["apps/api/src/routes/index.ts", "apps/frontend/src/instrumentation.ts", "phase1_5", "phase1_6"]
    },
    {
      "method": "POST",
      "apiPath": "/api/product-flow/receive",
      "owner": "external-product-flow-sync",
      "source": ["apps/api/src/routes/product-flow.ts", "phase1_6_sync_external"]
    },
    {
      "method": "POST",
      "apiPath": "/api/monitoring/products",
      "owner": "frontend-monitoring-kafka-rest-bridge",
      "source": ["apps/api/src/routes/monitoring.ts", "apps/frontend/src/app/admin/monitoring/page.tsx", "phase1_6_sync_external"]
    }
  ],
  "nonContractualFindings": [
    {
      "apiPath": "/api/auth/login",
      "reason": "Only appears inside a comment/example in apps/frontend/src/lib/config.ts. No route, frontend call, matrix entry, or golden treats it as a real endpoint."
    }
  ],
  "futureRequiredControls": [
    "Before any staging/cutover gate, access logging must record method, normalized path, status, timestamp, origin/host, sanitized user-agent and request id for /api/auth/* and external inbound endpoints.",
    "If access logs later show any /api/auth/* path not present in authEndpoints, migration must stop and characterize it before Python cutover.",
    "If access logs later show any external inbound endpoint not present in externalInboundEndpoints or the main contract matrix, migration must stop and characterize owner, auth, payload and compatibility."
  ]
}
