apps/backend/.hypothesis/

# next.js
/.next/
/out/
apps/frontend/.next/
apps/frontend/out/

# production
/build
**/dist/

# misc
.DS_Store
*.pem
.cookiejar
cookies.txt
profile.json
artifacts/
/.ruff_cache/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.docker

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database
*.db

