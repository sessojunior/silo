/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
**/coverage
/.visual-smoke/
/playwright-report/
/test-results/

# python
apps/backend/.venv/
apps/backend/.mypy_cache/
apps/backend/.pytest_cache/
apps/backend/.ruff_cache/
apps/backend/.coverage
apps/backend/htmlcov/
apps/backend/**/__pycache__/
